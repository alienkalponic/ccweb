@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}

    <section id="main-content">
        <section class="wrapper animate-fade-in">
            <h2 class="mb-4">Dashboard Overview</h2>
            <!--mini statistics start-->
            <div class="row">
                <div class="col-md-3">
                    <div class="mini-stat clearfix">
                        <span class="mini-stat-icon"><i class="fa fa-building-o"></i></span>
                        <div class="mini-stat-info">
                            <span>0</span>
                            Total Companies
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mini-stat clearfix">
                        <span class="mini-stat-icon"><i class="fa fa-users"></i></span>
                        <div class="mini-stat-info">
                            <span>0</span>
                            Total Candidates
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mini-stat clearfix">
                        <span class="mini-stat-icon"><i class="fa fa-briefcase"></i></span>
                        <div class="mini-stat-info">
                            <span>0</span>
                            Active Job Postings
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="mini-stat clearfix">
                        <span class="mini-stat-icon"><i class="fa fa-usd"></i></span>
                        <div class="mini-stat-info">
                            <span style="cursor:pointer" id="TotalEarning">0</span>
                            Total Earnings
                        </div>
                    </div>
                </div>
            </div>
            <!--mini statistics end-->

            <div class="row">
                <div class="col-md-12">
                    <div class="event-calendar clearfix">
                        <div class="col-lg-4 calendar-block">
                            <div class="cal1">
                            </div>
                        </div>
                        <div class="col-lg-8 event-list-block">
                            <div class="cal-day">
                                <span>Today</span>
                                Friday
                            </div>
                            <ul class="event-list">
                                <li>Lunch with jhon  3:30 <a href="javascript:void(0);" class="event-close"></a></li>
                                <li>Coffee meeting with Lisa  4:30 <a href="javascript:void(0);" class="event-close"></a></li>
                                <li>Skypee conf with patrick  5:45 <a href="javascript:void(0);" class="event-close"></a></li>
                                <li>Gym  7:00 <a href="javascript:void(0);" class="event-close"></a></li>
                                <li>Dinner with daniel  9:30 <a href="javascript:void(0);" class="event-close"></a></li>
                            </ul>

                        </div>
                    </div>
                </div>

            </div>
        </section>
    </section>

