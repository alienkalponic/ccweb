<div class="container-fluid mx-auto md:px-6 inspire" id="video">
	<!-- Section: Design Block -->
	<section class="mb-20 text-center md:text-left HomeVideoSection relative">
		<div class="HomeVideoOuter mb-10">
			<div class="wrapper">
				<div class="HomeVideoInner">
					<div class="Video-playbtn" id="videoPlayBtn">
						<svg xmlns="http://www.w3.org/2000/svg" width="15" height="17" viewBox="0 0 15 17">
							<path d="M8.5,0,17,15H0Z"
								  transform="translate(15) rotate(90)"
								  fill="#fff"></path>
						</svg>
					</div>

					<div class="StoryVideo">
						@* <video id="rightVideo" playsinline="" controls="" poster="">
							<source type="video/mp4" src="../Assets/images/5013967-uhd_4096_2160_25fps.mp4">
						</video> *@
						<iframe id="rightVideo"
								class="yt-video"
								src="https://www.youtube.com/embed/swL5Y0SpOBA?enablejsapi=1&rel=0"
								frameborder="0"
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
								allowfullscreen>
						</iframe>
					</div>
					<div class="HomeVideoTitleSection">
						<div class="SectionTitle">
							<h2>
								Course overview
							</h2>
						</div>
						<div class="SectionContent"></div>

					</div>
				</div>
			</div>
		</div>

		<button class="youtube-videos"><a href="https://www.w3.org/">Climbing video</a></button>
	</section>

</div>

