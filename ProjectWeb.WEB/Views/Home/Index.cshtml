@model ProjectWeb.Domain.Model.MultipleModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Home Page";
	string imagePath = Url.Content("~/");
	var projectApiUrl = Configuration.GetSection("ServiceUrls")["ProjectAPI"];
	var isFirst = true;
}
<!--===================banner=====================-->
<div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
	<ol class="carousel-indicators">
		@{
			var index = 0;
		}
		@foreach (var item in Model.BannerDtos!)
		{
			<li data-bs-target="#carouselExampleIndicators"
				data-bs-slide-to="@index"
				class="@(index == 0 ? "active" : "")"></li>

			index++;
		}
	</ol>
	<div class="carousel-inner">
		@foreach(var item in Model.BannerDtos!)
		{
			<div class="carousel-item @(isFirst ? "active" : "")">
				<img class="d-block w-100" src="@projectApiUrl@item.ImageUrl">
				<div class="carousel-caption d-none d-md-block">
					<p>@item.Caption</p>
				</div>
			</div>

			isFirst = false;

		}
		
		@* <div class="carousel-item">
			<img class="d-block w-100" src="../Assets/bannerSection/banner2.1.jpeg" alt="Second slide">
			<div class="carousel-caption d-none d-md-block">
				
				<p>Mt. Thalay Sagar (6,904 m) rising in the background, as seen from the Summit Camp (5,840 m) of Mt. Jogin.</p>
			</div>
		</div>
		<div class="carousel-item">
			<img class="d-block w-100" src="../Assets/bannerSection/banner4.jpg" alt="Third slide">
			<div class="carousel-caption d-none d-md-block">
				
				<p>Camp-I (5,150 m) of Mt.Ramjak</p>
			</div>
		</div>
		<div class="carousel-item">
			<img class="d-block w-100" src="../Assets/bannerSection/banner3.jpeg" alt="Third slide">
			<div class="carousel-caption d-none d-md-block">
				
				<p>Final push before reaching the Traill’s Pass (5,312 m).</p>
			</div>
		</div>
		
		<div class="carousel-item">
			<img class="d-block w-100" src="../Assets/bannerSection/banner6.jpeg" alt="Third slide">
			<div class="carousel-caption d-none d-md-block">
				
				<p>Negotiating a ridge en route to the summit camp of Mt. Ramjak.</p>
			</div>
		</div>
		<div class="carousel-item">
			<img class="d-block w-100" src="../Assets/bannerSection/banner5.jpeg" alt="Third slide">
			<div class="carousel-caption d-none d-md-block">
				
				<p>River crossing on the Pindar River, emerging from the Pindari Glacier, during the Traill’s Pass Expedition.</p>
			</div>
		</div>
		<div class="carousel-item">
			<img class="d-block w-100" src="../Assets/bannerSection/banner7.jpg" alt="Third slide">
			<div class="carousel-caption d-none d-md-block">
				
				<p>Climbing route of Mt.Ramjak (6,318 m) as seen from the Summit Camp (5,718 m).</p>
			</div>
		</div>
		<div class="carousel-item active">
			<img class="d-block w-100" src="../Assets/bannerSection/banner8.jpg" alt="Third slide">
			<div class="carousel-caption d-none d-md-block">
				
				<p>Negotiating the final summit ridge on the south face of Mt. Jogin-I (6,456 m).</p>
			</div>
		</div> *@
	</div>
	 <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-bs-slide="prev">
	<span class="carousel-control-prev-icon" aria-hidden="true"></span>
	<span class="sr-only">Previous</span>
	</a>
	<a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-bs-slide="next">
	<span class="carousel-control-next-icon" aria-hidden="true"></span>
	<span class="sr-only">Next</span>
	</a>
</div>
