<!------------------ACTIVITY-------------------->
<div class="container-fluied mx-auto md:px-6 service clearfix" id="activity">

	<section class="mb-32 text-center ">
		<h2 class="text-3xl font-bold great_section">
			OUR ACTIVITY
		</h2>
		<!-- Swiper -->
		<div class="swiper-container mySwiper">
			<div class="swiper-wrapper">
				@if (Model.ClubActivityDtos != null)
				{
					foreach (var item in Model.ClubActivityDtos)
					{
						<div class="swiper-slide slide-card" style="background-image: url('@($"{projectApiUrl}{item.ImageUrl}")')">
							<div>
								<a href="@Url.Action("ActivityDetails", "Home", new { id = item.ActivityId })" class="know-more-btn">Know more</a>
								<p class="card-title" style="color:ghostwhite">@item.Title</p>
							</div>
						</div>
					}
				}
				@* <div class="swiper-slide slide-card" style="background-image: url(../Assets/ActivityImg/Course.jpg)">
