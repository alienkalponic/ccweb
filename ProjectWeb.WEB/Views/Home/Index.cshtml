<script>
	let player;

	function onYouTubeIframeAPIReady() {
		player = new YT.Player('rightVideo');
	}

	document.getElementById("videoPlayBtn").addEventListener("click", function () {

		// ▶ Play video safely
		if (player && player.playVideo) {
			player.playVideo();
		}

		// 🎬 Trigger animation
		const titleSection = document.querySelector(".HomeVideoTitleSection");
		titleSection.classList.add("animate_it");
		titleSection.classList.remove("animate_reverse");

		// ❌ Hide play button
		this.style.display = "none";
	});
</script>



