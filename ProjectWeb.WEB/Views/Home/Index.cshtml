<!--===================banner=====================-->
<div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
	<ol class="carousel-indicators">
		<li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
		<li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
		<li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
	</ol>
	<div class="carousel-inner">
		<div class="carousel-item">
			<img class="d-block w-100" src="../Assets/bannerSection/banner2.jpg" alt="First slide">
			<div class="carousel-caption d-none d-md-block">
				@* <h5>Slider One Item</h5> *@
				<p>Camp-I (5,150 m) of Mt.Ramjak</p>
			</div>
		</div>
		<div class="carousel-item">
			<img class="d-block w-100" src="../Assets/bannerSection/banner2.1.jpeg" alt="Second slide">
			<div class="carousel-caption d-none d-md-block">
				@* <h5>Slider One Item</h5> *@
				<p>Mt. Thalay Sagar (6,904 m) rising in the background, as seen from the Summit Camp (5,840 m) of Mt. Jogin.</p>
			</div>
		</div>
		<div class="carousel-item">
			<img class="d-block w-100" src="../Assets/bannerSection/banner4.jpg" alt="Third slide">
			<div class="carousel-caption d-none d-md-block">
				@* <h5>Slider One Item</h5> *@
				<p>Camp-I (5,150 m) of Mt.Ramjak</p>
			</div>
		</div>
		<div class="carousel-item">
			<img class="d-block w-100" src="../Assets/bannerSection/banner3.jpeg" alt="Third slide">
			<div class="carousel-caption d-none d-md-block">
				@* <h5>Slider One Item</h5> *@
				<p>Final push before reaching the Traill’s Pass (5,312 m).</p>
			</div>
		</div>
		
		<div class="carousel-item">
			<img class="d-block w-100" src="../Assets/bannerSection/banner6.jpeg" alt="Third slide">
			<div class="carousel-caption d-none d-md-block">
				@* <h5>Slider One Item</h5> *@
				<p>Negotiating a ridge en route to the summit camp of Mt. Ramjak.</p>
			</div>
		</div>
		<div class="carousel-item">
			<img class="d-block w-100" src="../Assets/bannerSection/banner5.jpeg" alt="Third slide">
			<div class="carousel-caption d-none d-md-block">
				@* <h5>Slider One Item</h5> *@
				<p>River crossing on the Pindar River, emerging from the Pindari Glacier, during the Traill’s Pass Expedition.</p>
			</div>
		</div>
		<div class="carousel-item">
			<img class="d-block w-100" src="../Assets/bannerSection/banner7.jpg" alt="Third slide">
			<div class="carousel-caption d-none d-md-block">
				@* <h5>Slider One Item</h5> *@
				<p>Climbing route of Mt.Ramjak (6,318 m) as seen from the Summit Camp (5,718 m).</p>
			</div>
		</div>
		<div class="carousel-item active">
			<img class="d-block w-100" src="../Assets/bannerSection/banner8.jpg" alt="Third slide">
			<div class="carousel-caption d-none d-md-block">
				@* <h5>Slider One Item</h5> *@
				<p>Negotiating the final summit ridge on the south face of Mt. Jogin-I (6,456 m).</p>
			</div>
		</div>
	</div>
	 <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
	<span class="carousel-control-prev-icon" aria-hidden="true"></span>
	<span class="sr-only">Previous</span>
	</a>
	<a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
	<span class="carousel-control-next-icon" aria-hidden="true"></span>
	<span class="sr-only">Next</span>
	</a>
</div>
<!-- ======================about us======================== -->
<div class="container my-24 mx-auto md:px-6 About-1" id="about" style="background-image: url('https://localhost:7013/Assets/images/pexels-cottonbro-9665176.jpg');
    background-repeat: no-repeat; background-size: cover; background-position: bottom center; max-width: 100%; height: auto; color: #fff;
    display: flex; justify-content: center; align-items: center; text-align: center;">
	<!-- Section: Design Block -->
	<section class="mb-20 text-center md:text-left">
		<div class="block rounded-lg shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07),0_10px_20px_-2px_rgba(0,0,0,0.04)] dark:bg-neutral-700">
			<div class="flex flex-wrap items-center">
				<div class="w-full shrink-0 grow-0 basis-auto md:w-8/12 total-text">
					<div class="px-6 py-12 md:px-12">
						<h2 class="mb-6 text-3xl font-bold project_text">
							<span class="dark:text-danger-500 project_text_sub">Climb higher. Explore further. Grow stronger.</span>
							
						</h2>
						<p class="mb-6 text-neutral-500 dark:text-neutral-300  paragraph_text">
							
							<span style="font-weight:bold">Climbers’ Circle</span> marks fifty years of learning, dedication, and shared journeys in the mountains. Since 1977, our path has been shaped by time spent on rock, snow, ice across steep faces, high ridges, and demanding terrain guided by curiosity, discipline, and a deep respect for nature. What began as a small group of committed climbers has gradually grown into a community where generations have learned not only technical skills, but also patience, responsibility, and mutual support.
From sun-warmed crags to snowbound couloirs, from short technical pitches to remote and committing mountain objectives our members have developed their abilities through careful training, thoughtful expeditions, and countless hours on the rope together. We strive to uphold strong values of safety, teamwork, self-reliance, and exploration, knowing there is always more to learn. As we reflect on fifty years, we remain grateful to the mountains that taught us, the people who guided us, and the shared spirit that continues to inspire us as we look ahead to new routes and challenges yet to come..<a href="@Url.Action("About", "Home")#about-hills" style="color:royalblue">see more.</a>
						</p>
						@* <button onclick="myFunction()" id="myBtnreadmore">Read more</button>  *@
						
						<div class="image-box_about us">
							<!-- First Image Section -->
							<div class="w-full md:w-1/4 image_1">
								<img src="../Assets/images/360_F_714804168_pVCUZFBKxzayAe6dVqEwy4RrToJBTgfp.jpg" alt="About Us Image 1" class="w-full h-auto object-cover" loading="lazy" decoding="async">
							</div>

							<!-- Second Image Section -->
							<div class="w-full md:w-1/4 image_2">
								<img src="../Assets/images/images.jpeg" alt="About Us Image 2" class="w-full h-auto object-cover" loading="lazy" decoding="async">
								
							</div>
						</div>

					</div>
				</div>
				<!-- <div class="block w-full shrink-0 grow-0 basis-auto md:w-4/12 lg:flex about_image">
					<img src="https://mdbcdn.b-cdn.net/img/new/ecommerce/vertical/097.jpg" alt="Trendy Pants and Shoes" class="w-full rounded-t-lg md:rounded-tr-none md:rounded-bl-lg"/>
				</div> -->
			</div>
		</div>
	</section>
	<!-- Section: Design Block -->
</div> 

