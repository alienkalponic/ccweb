@{
    ViewData["Title"] = "About";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css" />
<style>
    .hills {
        position: relative;
        width: calc(min(90rem, 90%));
        margin: 0 auto;
        min-height: 100vh;
        column-gap: 3rem;
        padding-block: min(20vh, 3rem);
    }

    .bg {
        position: fixed;
        top: 1rem;
        left: -12rem;
        z-index: -1;
        opacity: 0;
    }

    .bg2 {
        position: fixed;
        bottom: -2rem;
        right: -10rem;
        z-index: -1;
        /* width: 9.375rem; */
        opacity: 0;
    }

    .hills > .hilles-text h3 {
        text-transform: capitalize;
        letter-spacing: 0.8px;
        font-family: "Roboto", sans-serif;
        font-weight: 300;
        font-size: clamp(3.4375rem, 3.25rem + 0.75vw, 4rem);
        background-color: #b08b45;
        background-image: linear-gradient(45deg, #b08b45, #b3ac86) background-size: 100%;
        background-repeat: repeat;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        -moz-background-clip: text;
        -moz-text-fill-color: transparent;
    }

    .hills > .hilles-text hr {
        display: block;
        background: #b08b45;
        height: 0.25rem;
        width: 6.25rem;
        border: none;
        margin: 1.125rem 0 1.875rem 0;
    }

    .hills > .hilles-text p {
        line-height: 1.6;
        color: #fff;
    }

    .hills a {
        display: inline-block;
        text-decoration: none;
        text-transform: uppercase;
        color: #717171;
        font-weight: 500;
        background: transparent;
        border-radius: 3.125rem;
        transition: 0.3s ease-in-out;
    }

    .hills > .hilles-text > a {
        border: 2px solid #c2c2c2;
        margin-top: 2.188rem;
        padding: 0.625rem 1.875rem;
    }

    .hills > .hilles-text > a:hover {
            border: 0.125rem solid #b08b45;
            color: #b08b45;
    }

    .swiper {
        width: 100%;
        padding-top: 3.125rem;
    }

    .swiper-pagination-bullet,
    .swiper-pagination-bullet-active {
        background: #fff;
    }

    .swiper-pagination {
        bottom: 1.25rem !important;
    }

    .swiper-slide {
        width: 18.75rem;
        height: 28.125rem;
        display: flex;
        flex-direction: column;
        justify-content: end;
        align-items: self-start;
    }

    .swiper-slide h2 {
        color: #fff;
        font-family: "Roboto", sans-serif;
        font-weight: 400;
        font-size: 1.4rem;
        line-height: 1.4;
        margin-bottom: 0.625rem;
        padding: 0 0 0 1.563rem;
        text-transform: uppercase;
    }

    .swiper-slide p {
        color: #dadada;
        font-family: "Roboto", sans-serif;
        font-weight: 300;
        padding: 0 1.563rem;
        line-height: 1.6;
        font-size: 0.75rem;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .swiper-slide a {
        margin: 1.25rem 1.563rem 0.438rem 1.563rem;
        padding: 0.438em 1.875rem;
        font-size: 0.9rem;
    }

    .swiper-slide a:hover {
        color: #005baa;
    }

    .swiper-slide div {
        display: none;
        opacity: 0;
        padding-bottom: 0.625rem;
    }

    .swiper-slide-active div {
        display: block;
        opacity: 1;
    }

    .swiper-slide--one {
        background: linear-gradient(to top, #0f2027, #203a4300, #2c536400), url("../Assets/AboutImg/about1.jpg") no-repeat 50% 50% / cover;
    }

    .swiper-slide--two {
        background: linear-gradient(to top, #0f2027, #203a4300, #2c536400), url("../Assets/AboutImg/about2.jpg") no-repeat 50% 50% / cover;
    }

    .swiper-slide--three {
        background: linear-gradient(to top, #0f2027, #203a4300, #2c536400), url("../Assets/AboutImg/about3.jpg") no-repeat 50% 50% / cover;
    }

    .swiper-slide--four {
        background: linear-gradient(to top, #0f2027, #203a4300, #2c536400), url("../Assets/AboutImg/about4.jpeg") no-repeat 50% 50% / cover;
    }

    .swiper-slide--five {
        background: linear-gradient(to top, #0f2027, #203a4300, #2c536400), url("../Assets/AboutImg/about6.jpeg") no-repeat 50% 50% / cover;
    }

    .swiper-slide--six {
        background: linear-gradient(to top, #0f2027, #203a4300, #2c536400), url("../Assets/AboutImg/about7.jpeg") no-repeat 50% 50% / cover;
    }

    .swiper-slide--seven {
        background: linear-gradient(to top, #0f2027, #203a4300, #2c536400), url("../Assets/AboutImg/about8.jpeg") no-repeat 50% 50% / cover;
    }

    .swiper-3d .swiper-slide-shadow-left,
    .swiper-3d .swiper-slide-shadow-right {
        background-image: none;
    }

    @@media screen and (min-width: 48rem) {
        hills {
            flex-direction: column;
            padding-block: 3rem;
        }

        .hilles-text,
        .swiper {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .swiper {
            margin-top: 2rem;
        }
    }

    .bg,
    .bg2 {
        opacity: 0.4;
    }

    @@media screen and (min-width: 93.75rem) {
        .swiper {
            width: 85%;
        }
    }
    /* Desktop */
/* @@media screen and (min-width: 1024px) {
    .swiper {
        width: 100%;
        max-width: 520px;
    }
} */

/* Large desktop */
/* @@media screen and (min-width: 1400px) {
