@model ProjectWeb.Domain.Model.MultipleModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Activity Details | Climbers' Circle";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string imagePath = Url.Content("~/");
    var projectApiUrl = Configuration.GetSection("ServiceUrls")["ProjectAPI"];
}

<link rel="stylesheet" href="~/Assets/Css/activity-details.css" asp-append-version="true" />



<div class="activity-details-page">
    <div class="container-limit">
        @if (Model.ActivityDetailsDto != null)
        {
            <!-- Hero Section -->
            <header class="activity-hero">
                <h1>@Model.ActivityDetailsDto.Title</h1>
                <p>@Model.ActivityDetailsDto.SubTitle</p>
            </header>

            <!-- Image Showcase -->
            <div class="activity-showcase">
                @foreach (var item in @Model.ActivityDetailsDto.Images!)
                {
                    <div class="showcase-image">
                        <img src="@projectApiUrl@item.ImagePath1" alt="Expedition Base Camp">
                    </div>
                }
                @* <div class="showcase-image">
                    <img src="~/Assets/ActivityImg/expedetion.jpg" alt="Expedition Base Camp">
                </div>
                <div class="showcase-image">
                    <img src="~/Assets/ActivityImg/hat.jpg" alt="Climbers at Dawn">
                </div> *@
            </div>

            <!-- Info Grid -->
            <div class="activity-info-grid">
                <div class="info-card">
                    <h3>Date</h3>
                    <p>
                        @Convert.ToDateTime(Model.ActivityDetailsDto!.StartDate).ToString("MMM dd, yyyy") - @Convert.ToDateTime(Model.ActivityDetailsDto!.EndDate).ToString("MMM dd, yyyy")
                    </p>
                </div>
                <div class="info-card">
                    <h3>Location</h3>
                    <p>@Model.ActivityDetailsDto.Location</p>
                </div>
                <div class="info-card">
                    <h3>Duration</h3>
                    <p>@Model.ActivityDetailsDto.Duration Days</p>
                </div>
                <div class="info-card">
                    <h3>Participation Fee</h3>
                    <p>₹@Model.ActivityDetailsDto.Fee / Person</p>
                </div>
            </div>

            <!-- Description Section -->
            <section class="activity-description">
                <h2>The Journey</h2>
                <p>@Html.Raw(Model.ActivityDetailsDto.Description)</p>

            </section>
        }


        @if (Model.ActivityDetailsDto?.FormAdd == true)
        {
            var actDto = Model.ActivityDetailsDto;
            DateTime startDate = new DateTime(DateTime.Now.Year, 12, 28);
            DateTime endDate = new DateTime(DateTime.Now.Year, 12, 31);
            bool hasDates = false;

            if (actDto != null && !string.IsNullOrEmpty(actDto.StartDate) && DateTime.TryParse(actDto.StartDate, out var sDate))
            {
                startDate = sDate;
                hasDates = true;
            }

            if (actDto != null && !string.IsNullOrEmpty(actDto.EndDate) && DateTime.TryParse(actDto.EndDate, out var eDate))
            {
                endDate = eDate;
            }
            else if (hasDates)
            {
                endDate = startDate;
            }

            var reportingDate = startDate.AddDays(-1);
            var returnDate = endDate.AddDays(1);
            var courseYear = hasDates ? startDate.Year : DateTime.Now.Year;

            string GetDaySuffix(int day)
            {
                if (day % 100 >= 11 && day % 100 <= 13) return $"{day}th";
                switch (day % 10)
                {
                    case 1: return $"{day}st";
                    case 2: return $"{day}nd";
                    case 3: return $"{day}rd";
                    default: return $"{day}th";
                }
            }

            string reportingDateText = $"{GetDaySuffix(reportingDate.Day)} {reportingDate:MMMM yyyy}";
            string returnDateText = $"{GetDaySuffix(returnDate.Day)} {returnDate:MMMM yyyy}";
            string displayFee = actDto?.Fee != null ? actDto.Fee.ToString() : "4000";
            decimal numFee = 4000;
            decimal.TryParse(displayFee, out numFee);
            decimal advFee = 2000;
            decimal balFee = numFee > advFee ? (numFee - advFee) : 0;

            <!-- Full Course Registration Form Embedded -->
            <section class="cc-registration-full" id="registration-form">
                
                <!-- Form Header -->
                <div class="cc-reg-header-top">
                    <div class="cc-reg-brand-info">
                        <img src="~/Assets/images/logo.jpeg" onerror="this.src='/Assets/images/CCLogo1.png';" alt="Climbers' Circle" class="cc-reg-logo" />
                        <div class="cc-reg-brand-text">
                            <span class="cc-reg-badge">Official Course Registration</span>
                            <h2>Course Registration Form @courseYear</h2>
                            <p><strong>Climbers' Circle</strong> &bull; 1923 Chattra Samity, Raja Subodh Mullick Square, Kolkata-700013</p>
                            <p class="cc-sub-desc">support@climberscircle.org &nbsp;|&nbsp; www.climberscircle.org</p>
                        </div>
                    </div>
                    <div class="cc-reg-header-actions">
                        <button type="button" onclick="prepareAndPrintRegistration()" class="cc-btn-print">
                            <i class="fa fa-print"></i> Print / Save as PDF
                        </button>
                    </div>
                </div>

                <!-- Minor notice banner -->
                <div class="cc-reg-notice-bar">
                    <i class="fa fa-info-circle"></i> <strong>Notice:</strong> Parents or guardian of minors must fill up and submit the form. (Please submit as soon as possible).
                </div>

                <form id="fullCourseRegistrationForm" method="post">
                    <input type="hidden" id="fullRegActivityId" name="clubActivityId" value="@Model.ActivityDetailsDto?.ActivityId" />
                    <input type="hidden" id="foodHabitVal" name="foodHabit" value="Veg" />
                    <input type="hidden" id="campingExpVal" name="campingExp" value="No" />

                    <!-- PANEL 1: Candidate Details -->
                    <div class="cc-form-panel">
                        <h3 class="cc-panel-title"><i class="fa fa-user"></i> Candidate &amp; Personal Details</h3>
                        <div class="cc-grid">
                            <!-- Name -->
                            <div class="cc-col-12 cc-field-group">
                                <label class="cc-field-label">Name <span class="cc-sub-desc">(in BLOCK Letters)</span> *</label>
                                <input type="text" id="fullRegName" name="name" class="cc-input-control" placeholder="FULL NAME IN BLOCK LETTERS" required />
                            </div>

                            <!-- Father's / Mother's Name -->
                            <div class="cc-col-12 cc-field-group">
                                <label class="cc-field-label">Father’s / Mother’s Name <span class="cc-sub-desc">(in BLOCK Letters)</span> *</label>
                                <input type="text" id="fullRegParentName" name="parentName" class="cc-input-control" placeholder="FATHER'S / MOTHER'S NAME" required />
                            </div>

                            <!-- Address Line 1 -->
                            <div class="cc-col-6 cc-field-group">
                                <label class="cc-field-label">Residential Address (Line 1) *</label>
                                <input type="text" id="fullRegAddress1" name="address1" class="cc-input-control" placeholder="House / Flat / Street address" required />
                            </div>

                            <!-- Address Line 2 -->
                            <div class="cc-col-6 cc-field-group">
                                <label class="cc-field-label">Address (Line 2 &amp; PIN code)</label>
                                <input type="text" id="fullRegAddress2" name="address2" class="cc-input-control" placeholder="City, State, PIN code" />
                            </div>

                            <!-- Contact Numbers -->
                            <div class="cc-col-6 cc-field-group">
                                <label class="cc-field-label">Candidate’s Contact No. *</label>
                                <input type="tel" id="fullRegPhone" name="phone" class="cc-input-control" placeholder="+91 98765 43210" required />
                            </div>
                            <div class="cc-col-6 cc-field-group">
                                <label class="cc-field-label">Guardian’s Contact No. *</label>
                                <input type="tel" id="fullRegGuardianPhone" name="guardianPhone" class="cc-input-control" placeholder="+91 98765 43210" required />
                            </div>

                            <!-- Gender, DOB, Age, Blood Group -->
                            <div class="cc-col-3 cc-field-group">
                                <label class="cc-field-label">Gender</label>
                                <input type="text" id="fullRegGender" name="gender" class="cc-input-control" placeholder="Male / Female" />
                            </div>
                            <div class="cc-col-3 cc-field-group">
                                <label class="cc-field-label">Date of Birth</label>
                                <input type="date" id="fullRegDob" name="dob" class="cc-input-control" />
                            </div>
                            <div class="cc-col-3 cc-field-group">
                                <label class="cc-field-label">Age</label>
                                <input type="number" id="fullRegAge" name="age" class="cc-input-control" placeholder="Age in yrs" />
                            </div>
                            <div class="cc-col-3 cc-field-group">
                                <label class="cc-field-label">Blood Group</label>
                                <input type="text" id="fullRegBloodGroup" name="bloodGroup" class="cc-input-control" placeholder="e.g. O+, B+, A+" />
                            </div>

                            <!-- Profession & Email -->
                            <div class="cc-col-6 cc-field-group">
                                <label class="cc-field-label">Profession / Student</label>
                                <input type="text" id="fullRegProfession" name="profession" class="cc-input-control" placeholder="e.g. Student, Service, Business" />
                            </div>
                            <div class="cc-col-6 cc-field-group">
                                <label class="cc-field-label">Email Address *</label>
                                <input type="email" id="fullRegEmail" name="email" class="cc-input-control" placeholder="candidate@example.com" required />
                            </div>

                            <!-- Mother Tongue, Food Habit, Weight -->
                            <div class="cc-col-4 cc-field-group">
                                <label class="cc-field-label">Mother Tongue</label>
                                <input type="text" id="fullRegLanguage" name="motherTongue" class="cc-input-control" placeholder="Bengali, English, Hindi..." />
                            </div>
                            <div class="cc-col-4 cc-field-group">
                                <label class="cc-field-label">Food Habit</label>
                                <div class="cc-toggle-pills">
                                    <div class="cc-toggle-pill active" onclick="setFoodHabit(this, 'Veg')">Veg</div>
                                    <div class="cc-toggle-pill" onclick="setFoodHabit(this, 'Non-Veg')">Non-Veg</div>
                                </div>
                            </div>
                            <div class="cc-col-4 cc-field-group">
                                <label class="cc-field-label">Weight (Kg)</label>
                                <input type="text" id="fullRegWeight" name="weight" class="cc-input-control" placeholder="e.g. 62 Kg" />
                            </div>

                            <!-- Height & Preferable Journey Time -->
                            <div class="cc-col-3 cc-field-group">
                                <label class="cc-field-label">Height (Feet)</label>
                                <input type="number" id="fullRegHeightFt" name="heightFt" class="cc-input-control" placeholder="ft" />
                            </div>
                            <div class="cc-col-3 cc-field-group">
                                <label class="cc-field-label">Height (Inches)</label>
                                <input type="number" id="fullRegHeightIn" name="heightIn" class="cc-input-control" placeholder="inch" />
                            </div>
                            <div class="cc-col-6 cc-field-group">
                                <label class="cc-field-label">Preferable Journey Time</label>
                                <input type="text" id="fullRegJourneyTime" name="journeyTime" class="cc-input-control" placeholder="Preferred travel schedule / train" />
                            </div>

                            <!-- Physical Problem -->
                            <div class="cc-col-12 cc-field-group">
                                <label class="cc-field-label">Physical Problem (if any)</label>
                                <input type="text" id="fullRegPhysicalProblem" name="physicalProblem" class="cc-input-control" placeholder="Mention in brief if you have, otherwise enter Not Applicable" />
                            </div>

                            <!-- Previous Experience -->
                            <div class="cc-col-12 cc-field-group">
                                <label class="cc-field-label">Previous Experience in Camping / Rock Climbing / Mountaineering / Trekking</label>
                                <div class="cc-toggle-pills" style="max-width: 250px;">
                                    <div class="cc-toggle-pill" onclick="setCampingExp(this, 'Yes')">Yes</div>
                                    <div class="cc-toggle-pill active" onclick="setCampingExp(this, 'No')">No</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- PANEL 2: Course Applied For -->
                    <div class="cc-form-panel">
                        <h3 class="cc-panel-title"><i class="fa fa-compass"></i> Course Applied For</h3>
                        <div class="cc-courses-grid">
                            <div class="cc-course-card" onclick="toggleCourseCheck(this)">
                                <div class="cc-check-indicator"><i class="fa fa-check"></i></div>
                                <span class="cc-course-title">Adventure Camping</span>
                            </div>
                            <div class="cc-course-card checked" onclick="toggleCourseCheck(this)">
                                <div class="cc-check-indicator"><i class="fa fa-check"></i></div>
                                <span class="cc-course-title">Basic Rock Climbing</span>
                            </div>
                            <div class="cc-course-card" onclick="toggleCourseCheck(this)">
                                <div class="cc-check-indicator"><i class="fa fa-check"></i></div>
                                <span class="cc-course-title">Trekking for Seniors</span>
                            </div>
                            <div class="cc-course-card" onclick="toggleCourseCheck(this)">
                                <div class="cc-check-indicator"><i class="fa fa-check"></i></div>
                                <span class="cc-course-title">Practice Rope</span>
                            </div>
                        </div>
                    </div>

                    <!-- PANEL 3: Registration Confirmation & Fees -->
                    <div class="cc-form-panel">
                        <h3 class="cc-panel-title"><i class="fa fa-credit-card"></i> Registration Confirmation &amp; Fees</h3>
                        <div class="cc-fee-row">
                            <div class="cc-fee-card highlight">
                                <div class="cc-fee-label">Total Registration Fee</div>
                                <div class="cc-fee-value">₹@displayFee</div>
                            </div>
                            <div class="cc-fee-card">
                                <div class="cc-fee-label">Minimum Advance Required</div>
                                <div class="cc-fee-value">₹2,000/-</div>
                            </div>
                            <div class="cc-fee-card">
                                <div class="cc-fee-label">Balance Payable</div>
                                <div class="cc-fee-value">₹@balFee.ToString("N0")/-</div>
                            </div>
                        </div>
                        <div class="cc-fee-nb">
                            <i class="fa fa-exclamation-triangle"></i> <strong>NB:</strong> In case of cancellation, advance payment will not be refunded.
                        </div>
                    </div>

                    <!-- PANEL 4: Declaration & Strict Discipline -->
                    <div class="cc-form-panel">
                        <h3 class="cc-panel-title"><i class="fa fa-file-text-o"></i> Declaration &amp; Discipline Undertaking</h3>
                        <div class="cc-declaration-box">
                            "I agree to follow the discipline, rules, and instructions of the organizing authorities. Incommensurate with the inherent risks, hazards, and dangers associated with outdoor activities in which I will engage, I confirm that I am physically and mentally capable of participating in such activity. My participation is voluntary and I will assume responsibility for personal injury, accidents, illness, and damage to or loss of personal property as the result of any incident or accident that case may be. I will not hold the organizers responsible for any injury or accident beyond their control."
                        </div>

                        <div class="cc-grid" style="margin-bottom: 12px;">
                            <div class="cc-col-6 cc-field-group">
                                <label class="cc-field-label">Date</label>
                                <input type="text" class="cc-input-control" value="@DateTime.Now.ToString("dd MMMM yyyy")" readonly />
                            </div>
                            <div class="cc-col-6 cc-field-group">
                                <label class="cc-field-label">Place</label>
                                <input type="text" id="fullRegPlace" class="cc-input-control" placeholder="e.g. Kolkata" />
                            </div>
                        </div>

                        <!-- Discipline Warning -->
                        <div class="cc-discipline-callout">
                            <strong><i class="fa fa-shield"></i> STRICT DISCIPLINE POLICY:</strong>
                            We are very strict in maintaining discipline. Our Rock climbing course is a serious rock climbing training program. There will be no personal free time. No scope for leisure or amusement. Mobile phones will not be allowed from 5:30 am till 9:30 pm during the course.
                        </div>
                    </div>

                    <!-- PANEL 5: Emergency Details -->
                    <div class="cc-form-panel">
                        <h3 class="cc-panel-title"><i class="fa fa-heartbeat"></i> In Case of Emergency</h3>
                        <div class="cc-grid">
                            <div class="cc-col-6 cc-field-group">
                                <label class="cc-field-label">Contact Name *</label>
                                <input type="text" id="fullRegEmergName" name="emergName" class="cc-input-control" placeholder="Emergency contact person name" required />
                            </div>
                            <div class="cc-col-6 cc-field-group">
                                <label class="cc-field-label">Relationship with Participant *</label>
                                <input type="text" id="fullRegEmergRelation" name="emergRelation" class="cc-input-control" placeholder="Father / Mother / Spouse / Relative" required />
                            </div>
                            <div class="cc-col-6 cc-field-group">
                                <label class="cc-field-label">Emergency Contact Number *</label>
                                <input type="tel" id="fullRegEmergPhone" name="emergPhone" class="cc-input-control" placeholder="+91 98765 43210" required />
                            </div>
                            <div class="cc-col-6 cc-field-group">
                                <label class="cc-field-label">Emergency Contact Address</label>
                                <input type="text" id="fullRegEmergAddress" name="emergAddress" class="cc-input-control" placeholder="Residential address of emergency contact" />
                            </div>
                        </div>
                    </div>

                    <!-- PANEL 6: Important Required Gear List -->
                    <div class="cc-form-panel">
                        <h3 class="cc-panel-title"><i class="fa fa-list-check"></i> Important Required Items Checklist</h3>
                        <p class="cc-sub-desc" style="color: #bbb; margin-bottom: 10px;">Please bring all of the following gear and personal accessories along with you:</p>
                        
                        <div class="cc-gear-grid">
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> One Rucksack / Bag</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> One Knapsack / Day-bag</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Polythene sheet (2.5m) (for Camping)</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Foam mattress</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Sleeping bag / Single blanket</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> 2 Full sleeve cotton shirts / T-shirts</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> 2 Cotton trousers / Track Pants</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Extra Undergarments</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> 1 Full sleeve sweater</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Windproof jacket / Cheater</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Woollen cap</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> 3 Pairs of cotton socks</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Walking/Running shoes &amp; Slippers</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Rice plate / Mess tin</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Spoon, Plastic Mug / Cup, Water bottle</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Toothpaste, brush, Soap &amp; Cold cream</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Torch (with extra cells)</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Exercise book / Diary &amp; Pen</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Basic personal medicines</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Safety pin, Needle and thread</div>
                            <div class="cc-gear-pill"><i class="fa fa-check"></i> Mosquito repellent cream</div>
                        </div>
                    </div>

                    <!-- PANEL 7: Joining Details & Schedule -->
                    <div class="cc-form-panel">
                        <h3 class="cc-panel-title"><i class="fa fa-calendar-check-o"></i> Joining &amp; Reporting Details</h3>
                        <div class="cc-schedule-details">
                            <p style="margin-bottom: 8px;">
                                Participants are requested to report to Club officials in front of the Enquiry booth at <b>Howrah Station (New Complex)</b> &mdash; Contact Person: <b>Tanmay (9903416262) / Santosh (8337018081) / Prabir (9831002109)</b> on <b class="cc-schedule-highlight">@reportingDateText at 10.00 PM</b> along with their luggage.
                            </p>
                            <p style="margin-bottom: 8px;">
                                <b>Note:</b> No dinner will be provided on <b class="cc-schedule-highlight">@reportingDateText (night)</b> by the Club.
                            </p>
                            <p style="margin: 0;">
                                <b>Date of return:</b> At Howrah Station on <b class="cc-schedule-highlight">@returnDateText at approx. 4:30 AM</b>.
                            </p>
                        </div>
                    </div>

                    <!-- PANEL 8: Payment Details -->
                    <div class="cc-form-panel">
                        <h3 class="cc-panel-title"><i class="fa fa-qrcode"></i> Payment Options (UPI / Bank Transfer)</h3>
                        <div class="cc-payment-container">
                            
                            <!-- UPI Box -->
                            <div class="cc-upi-card">
                                <div>
                                    <div class="cc-upi-title"><i class="fa fa-mobile"></i> Online UPI Payment</div>
                                    <div class="cc-upi-info">
                                        Account Name: <b>Dipta Bhandary</b><br>
                                        Mobile: <b>8420480075</b><br>
                                        UPI ID: <b class="cc-schedule-highlight">bhandarydipta-2@okicici</b>
                                    </div>
                                </div>
                                <div class="cc-qr-wrap">
                                    <img src="~/Assets/images/dipta_qr.jpg" alt="Dipta UPI QR" class="cc-qr-img" onclick="openQrModal()" title="Click to enlarge QR Code" />
                                    <span class="cc-qr-label"><i class="fa fa-search-plus"></i> Tap to Enlarge</span>
                                </div>
                            </div>

                            <!-- Bank Transfer Box -->
                            <div class="cc-bank-card">
                                <div class="cc-bank-title"><i class="fa fa-university"></i> Bank Transfer Details</div>
                                <div class="cc-bank-info">
                                    A/C Name: <b>CLIMBERS CIRCLE</b><br>
                                    Bank: <b>PUNJAB NATIONAL BANK</b><br>
                                    Branch: <b>NEW MARKET BRANCH</b><br>
                                    A/C Number: <b>0093000109098326</b><br>
                                    IFSC Code: <b>PUNB0009300</b>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Actions -->
                    <div class="cc-form-actions">
                        <button type="button" onclick="prepareAndPrintRegistration()" class="cc-btn-print">
                            <i class="fa fa-print"></i> Print / Save as PDF
                        </button>
                        <button type="submit" class="cc-btn-submit-full" id="btnSubmitFullRegistration">
                            <i class="fa fa-check-circle"></i> Submit Application
                        </button>
                    </div>
                </form>
            </section>

            <!-- ===================================================================
                 EXACT ORIGINAL 2-PAGE A4 DOCUMENT (RENDERED ONLY ON PRINT / PDF)
                 =================================================================== -->
            <div class="cc-print-document" id="printableCourseFormDoc">
                
                <!-- PAGE 1: Course Registration Form (EXACT MATCH TO ORIGINAL DESIGN) -->
                <div class="page-container">
                    
                    <!-- Header -->
                    <div class="form-header">
                        <div class="header-logo-wrap">
                            <img src="~/Assets/images/logo.jpeg" onerror="this.src='/Assets/images/CCLogo1.png';" alt="Logo" />
                        </div>
                        <div class="header-details-wrap">
                            <h1 class="org-name">Climbers' Circle</h1>
                            <p class="org-address">1923 Chattra Samity, Raja Subodh Mullick Square, Kolkata-700013</p>
                            <p class="org-contact">support@climberscircle.org &nbsp;I&nbsp; www.climberscircle.org</p>
                            <h2 class="doc-title">Course Registration Form @courseYear</h2>
                        </div>
                    </div>

                    <p class="minor-notice">
                        Parents or guardian of minors must fill up and sign the form. (Please return to us as soon as possible.)
                    </p>

                    <!-- Form Rows -->
                    <div class="form-row">
                        <span class="field-label" style="min-width: 190px;">Name <span class="sub-desc">(in BLOCK Letters)</span></span>
                        <input type="text" id="pName" class="form-box flex-fill" />
                    </div>

                    <div class="form-row">
                        <span class="field-label" style="min-width: 275px;">Father’s/ Mother’s Name <span class="sub-desc">(in BLOCK Letters)</span></span>
                        <input type="text" id="pParent" class="form-box flex-fill" />
                    </div>

                    <div class="form-row">
                        <span class="field-label" style="min-width: 70px;">Address</span>
