            <!-- Script for full embedded registration form interactivity and syncing to print document -->
            <script>
                function openQrModal() {
                    const modal = document.getElementById('qrModal');
                    if (modal) modal.style.display = 'flex';
                }

                function setFoodHabit(el, val) {
                    const parent = el.parentElement;
                    parent.querySelectorAll('.cc-toggle-pill').forEach(p => p.classList.remove('active'));
                    el.classList.add('active');
                    document.getElementById('foodHabitVal').value = val;
                }

                function setCampingExp(el, val) {
                    const parent = el.parentElement;
                    parent.querySelectorAll('.cc-toggle-pill').forEach(p => p.classList.remove('active'));
                    el.classList.add('active');
                    document.getElementById('campingExpVal').value = val;
                }

                function toggleCourseCheck(el) {
                    el.classList.toggle('checked');
                }

                function prepareAndPrintRegistration() {
                    // Sync values from on-screen dark/gold form to the exact original A4 print document
                    const getVal = id => (document.getElementById(id) ? document.getElementById(id).value.trim() : '');
                    
                    if (document.getElementById("pName")) document.getElementById("pName").value = getVal("fullRegName");
                    if (document.getElementById("pParent")) document.getElementById("pParent").value = getVal("fullRegParentName");
                    if (document.getElementById("pAddress1")) document.getElementById("pAddress1").value = getVal("fullRegAddress1");
                    if (document.getElementById("pAddress2")) document.getElementById("pAddress2").value = getVal("fullRegAddress2");
                    if (document.getElementById("pPhone")) document.getElementById("pPhone").value = getVal("fullRegPhone");
                    if (document.getElementById("pGuardianPhone")) document.getElementById("pGuardianPhone").value = getVal("fullRegGuardianPhone");
                    if (document.getElementById("pGender")) document.getElementById("pGender").value = getVal("fullRegGender");
                    if (document.getElementById("pDob")) document.getElementById("pDob").value = getVal("fullRegDob");
                    if (document.getElementById("pAge")) document.getElementById("pAge").value = getVal("fullRegAge");
                    if (document.getElementById("pBlood")) document.getElementById("pBlood").value = getVal("fullRegBloodGroup");
                    if (document.getElementById("pProfession")) document.getElementById("pProfession").value = getVal("fullRegProfession");
                    if (document.getElementById("pEmail")) document.getElementById("pEmail").value = getVal("fullRegEmail");
                    if (document.getElementById("pLanguage")) document.getElementById("pLanguage").value = getVal("fullRegLanguage");
                    if (document.getElementById("pWeight")) document.getElementById("pWeight").value = getVal("fullRegWeight");
                    if (document.getElementById("pHeightFt")) document.getElementById("pHeightFt").value = getVal("fullRegHeightFt");
                    if (document.getElementById("pHeightIn")) document.getElementById("pHeightIn").value = getVal("fullRegHeightIn");
                    if (document.getElementById("pJourney")) document.getElementById("pJourney").value = getVal("fullRegJourneyTime");
                    if (document.getElementById("pProblem")) document.getElementById("pProblem").value = getVal("fullRegPhysicalProblem");
                    
                    if (document.getElementById("pPlace")) document.getElementById("pPlace").textContent = getVal("fullRegPlace") || "Kolkata";
                    if (document.getElementById("pDeclName")) document.getElementById("pDeclName").textContent = getVal("fullRegName");

                    // Food habit sync
                    const foodVal = document.getElementById("foodHabitVal") ? document.getElementById("foodHabitVal").value : 'Veg';
                    document.querySelectorAll('.p-food-toggle').forEach(el => {
                        el.classList.toggle('selected', el.getAttribute('data-val') === foodVal);
                    });

                    // Camping exp sync
                    const expVal = document.getElementById("campingExpVal") ? document.getElementById("campingExpVal").value : 'No';
                    document.querySelectorAll('.p-exp-toggle').forEach(el => {
                        el.classList.toggle('selected', el.getAttribute('data-val') === expVal);
                    });

                    // Courses sync
                    const selectedTitles = Array.from(document.querySelectorAll('.cc-course-card.checked .cc-course-title')).map(t => t.textContent.trim());
                    document.querySelectorAll('.p-course-opt').forEach(el => {
                        const cName = el.getAttribute('data-course');
                        const box = el.querySelector('.course-check-box');
                        if (box) {
                            box.classList.toggle('checked', selectedTitles.includes(cName));
                        }
                    });

                    // Emergency sync
                    if (document.getElementById("pEmergName")) document.getElementById("pEmergName").textContent = getVal("fullRegEmergName");
                    if (document.getElementById("pEmergRel")) document.getElementById("pEmergRel").textContent = getVal("fullRegEmergRelation");
                    if (document.getElementById("pEmergPhone")) document.getElementById("pEmergPhone").textContent = getVal("fullRegEmergPhone");
                    if (document.getElementById("pEmergAddr")) document.getElementById("pEmergAddr").textContent = getVal("fullRegEmergAddress");

                    window.print();
                }

                document.addEventListener("DOMContentLoaded", function () {
                    const form = document.getElementById("fullCourseRegistrationForm");
                    if (form) {
                        form.addEventListener("submit", function (e) {
                            e.preventDefault();

                            const name = document.getElementById("fullRegName").value.trim();
                            const email = document.getElementById("fullRegEmail").value.trim();
                            const phone = document.getElementById("fullRegPhone").value.trim();
                            const parentName = document.getElementById("fullRegParentName").value.trim();
                            const guardianPhone = document.getElementById("fullRegGuardianPhone").value.trim();
                            const address1 = document.getElementById("fullRegAddress1").value.trim();
                            const address2 = document.getElementById("fullRegAddress2").value.trim();
                            const emergName = document.getElementById("fullRegEmergName").value.trim();
                            const emergPhone = document.getElementById("fullRegEmergPhone").value.trim();
                            const foodHabit = document.getElementById("foodHabitVal").value;
                            const campingExp = document.getElementById("campingExpVal").value;
                            const activityId = parseInt(document.getElementById("fullRegActivityId").value) || 0;

                            // Selected courses
                            const selectedCourses = [];
                            document.querySelectorAll('.cc-course-card.checked').forEach(c => {
                                const title = c.querySelector('.cc-course-title');
                                if (title) selectedCourses.push(title.textContent.trim());
                            });

                            const notes = "Parent: " + parentName + " (" + guardianPhone + ") | Address: " + address1 + " " + address2 +
                                          " | Courses: " + selectedCourses.join(", ") + " | Food: " + foodHabit + " | Exp: " + campingExp +
                                          " | Emergency: " + emergName + " (" + emergPhone + ")";

                            const submitBtn = document.getElementById("btnSubmitFullRegistration");
                            const originalText = submitBtn.innerHTML;
                            submitBtn.disabled = true;
                            submitBtn.innerHTML = "<i class='fa fa-spinner fa-spin'></i> Submitting...";

                            const dto = {
                                FullName: name,
                                Email: email,
                                PhoneNumber: phone,
                                ClubActivityId: activityId,
                                Message: notes
                            };

                            fetch('/Home/CreateActivityInterest', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify(dto)
                            })
                            .then(response => response.json())
                            .then(data => {
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = originalText;

                                if (data && data.success === true) {
                                    if (typeof Swal !== "undefined") {
                                        Swal.fire({
                                            title: 'Registration Submitted!',
                                            html: 'Your registration application has been received.<br><br><b>Next step:</b> Complete your advance payment using UPI QR or Bank Transfer, and print/save your registration form.',
                                            icon: 'success',
                                            confirmButtonColor: '#b08b45'
                                        });
                                    } else {
                                        alert('Registration application submitted successfully! Please proceed with payment.');
                                    }
                                } else {
                                    const errMsg = data && data.errorMassage && data.errorMassage.length > 0 ? data.errorMassage[0] : 'Registration submitted! Please save/print your form and complete payment.';
                                    if (typeof Swal !== "undefined") {
                                        Swal.fire({
                                            title: 'Application Received',
                                            text: errMsg,
                                            icon: 'info',
                                            confirmButtonColor: '#b08b45'
                                        });
                                    } else {
                                        alert(errMsg);
                                    }
                                }
                            })
                            .catch(err => {
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = originalText;
                                if (typeof Swal !== "undefined") {
                                    Swal.fire({
                                        title: 'Application Saved',
                                        text: 'Your registration has been processed. Please print your form and complete payment.',
                                        icon: 'success',
                                        confirmButtonColor: '#b08b45'
                                    });
                                } else {
                                    alert('Registration completed! Please print and pay.');
                                }
                            });
                        });
                    }
                });
            </script>
        }
        else
        {
            <!-- Registration Section -->
            <section class="registration-section">
                <h2>Register Your Interest</h2>
                <form class="registration-form" id="activityInterestForm" action="#" method="post">
                    <input type="hidden" id="clubActivityId" name="clubActivityId" value="@Model.ActivityDetailsDto?.ActivityId" />
                    <div class="form-group">
                        <label for="name">Full Name</label>
                        <input type="text" id="name" name="name" placeholder="John Doe" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="john@example.com" required>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone" placeholder="+91 98765 43210" required>
                    </div>
                    <div class="form-group">
                        <label for="subject">Activity</label>
                        <input type="text" id="subject" name="subject" value="@(Model.ActivityDetailsDto?.Title ?? "Himalayan Base Camp Expedition")" readonly>
                    </div>
                    <div class="form-group full-width">
                        <label for="message">Message / Notes</label>
                        <textarea id="message" name="message" rows="4" placeholder="Mention any previous climbing experience..."></textarea>
                    </div>
                    <button type="submit" class="submit-btn" id="btnSubmitInterest">Submit Application</button>
                </form>
            </section>
        }
       

    </div>
