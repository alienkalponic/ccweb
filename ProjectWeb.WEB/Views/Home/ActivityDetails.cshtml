@{
    ViewData["Title"] = "Activity Details | Climbers' Circle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Assets/Css/activity-details.css" asp-append-version="true" />

<div class="activity-details-page">
    <div class="container-limit">
        
        <!-- Hero Section -->
        <header class="activity-hero">
            <h1>Himalayan Base Camp Expedition</h1>
            <p>Journey to the heart of the mountains. An alpine experience for those who seek the silence of the high peaks.</p>
        </header>

        <!-- Image Showcase -->
        <div class="activity-showcase">
            <div class="showcase-image">
                <img src="~/Assets/ActivityImg/expedetion.jpg" alt="Expedition Base Camp">
            </div>
            <div class="showcase-image">
                <img src="~/Assets/images/banner1.jpg" alt="Climbers at Dawn">
            </div>
        </div>

        <!-- Info Grid -->
        <div class="activity-info-grid">
            <div class="info-card">
                <h3>Date</h3>
                <p>Oct 15 - Nov 05, 2026</p>
            </div>
            <div class="info-card">
                <h3>Location</h3>
                <p>Khumbu Region, Nepal</p>
            </div>
            <div class="info-card">
                <h3>Duration</h3>
                <p>21 Days</p>
            </div>
            <div class="info-card">
                <h3>Participation Fee</h3>
                <p>₹45,000 / Person</p>
            </div>
        </div>

        <!-- Description Section -->
        <section class="activity-description">
            <h2>The Journey</h2>
            <p>This expedition is designed for experienced trekkers and aspiring climbers. We will establish a base camp at 5,300m and explore the surrounding technical ridges. The focus is on safety, team-building, and experiencing the raw beauty of the Himalayas in an environment that respects both the mountains and the spirits of those who wander them.</p>
            <p style="margin-top: 1rem;">Experience the camaraderie of the rope team, the clarity of high-altitude air, and the legacy of our fifty-year-old climbing circle.</p>
        </section>

        <!-- Registration Section -->
        <section class="registration-section">
            <h2>Register Your Interest</h2>
            <form class="registration-form" action="#" method="post">
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" placeholder="John Doe" required>
                </div>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="john@example.com" required>
                </div>
                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="tel" id="phone" name="phone" placeholder="+91 98765 43210" required>
                </div>
                <div class="form-group">
                    <label for="subject">Activity</label>
                    <input type="text" id="subject" name="subject" value="Himalayan Base Camp Expedition" readonly>
                </div>
                <div class="form-group full-width">
                    <label for="message">Message / Notes</label>
                    <textarea id="message" name="message" rows="4" placeholder="Mention any previous climbing experience..."></textarea>
                </div>
                <button type="submit" class="submit-btn" onclick="event.preventDefault(); alert('Registration Mock Successful! Our team will contact you soon.');">Submit Application</button>
            </form>
        </section>

    </div>
</div>
