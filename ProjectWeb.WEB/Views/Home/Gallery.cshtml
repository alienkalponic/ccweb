@model ProjectWeb.Domain.Model.MultipleModel
@inject IConfiguration Configuration
@{
    var dto = Model?.AchievementDetailsGalleryDtos;
    var rawCategory = (ViewBag.CategoryName as string ?? dto?.SubTitle ?? "").Trim();
    var lowerCat = rawCategory.ToLowerInvariant();
    var lowerTitle = (dto?.Title ?? "").ToLowerInvariant();

    string segmentType;
    string segmentTagline;
    string segmentTaglineIcon;
    string segmentHighlightsTitle;
    string segmentHighlightsSubtitle;
    string segmentAscentBadge;
    string segmentFramePrefix;

    if (lowerCat.Contains("trek") || lowerCat.Contains("hat") || lowerCat.Contains("trail") || lowerCat.Contains("hike") || lowerTitle.Contains("trek"))
    {
        segmentType = "Trek";
        segmentTagline = "Photographic Trek Log";
        segmentTaglineIcon = "fa-person-hiking";
        segmentHighlightsTitle = "Visual Trek Highlights";
        segmentHighlightsSubtitle = "High-resolution frames, mountain trail passes, wilderness base camps, and scenic terrain documented along the trek.";
        segmentAscentBadge = "Verified Club Trek";
        segmentFramePrefix = "Trek Frame";
    }
    else if (lowerCat.Contains("climb") || lowerCat.Contains("rock") || lowerCat.Contains("boulder") || lowerCat.Contains("lead") || lowerTitle.Contains("climb") || lowerTitle.Contains("face"))
    {
        segmentType = "Climb";
        segmentTagline = "Photographic Climbing Log";
        segmentTaglineIcon = "fa-mountain";
        segmentHighlightsTitle = "Visual Climbing Highlights";
        segmentHighlightsSubtitle = "High-resolution frames, crux pitches, anchor placements, and sheer rock face ascents documented during the climb.";
        segmentAscentBadge = "Verified Technical Ascent";
        segmentFramePrefix = "Pitch";
    }
    else if (lowerCat.Contains("train") || lowerCat.Contains("course") || lowerCat.Contains("camp") || lowerCat.Contains("workshop") || lowerTitle.Contains("course") || lowerTitle.Contains("training"))
    {
        segmentType = "Training";
        segmentTagline = "Photographic Training Log";
        segmentTaglineIcon = "fa-graduation-cap";
        segmentHighlightsTitle = "Visual Training & Course Highlights";
        segmentHighlightsSubtitle = "Practical fieldwork, rope-handling drills, knot techniques, safety exercises, and team preparation moments.";
        segmentAscentBadge = "Certified Club Training";
        segmentFramePrefix = "Session";
    }
    else if (lowerCat.Contains("expedition") || lowerCat.Contains("summit") || lowerCat.Contains("alpine") || lowerCat.Contains("peak") || lowerCat.Contains("reconnaissance") || lowerTitle.Contains("expedition"))
    {
        segmentType = "Expedition";
        segmentTagline = "Photographic Log";
        segmentTaglineIcon = "fa-camera";
        segmentHighlightsTitle = "Visual Expedition Highlights";
        segmentHighlightsSubtitle = "High-resolution frames, crux pitches, glacier traverses, and environmental conditions documented during the ascent.";
        segmentAscentBadge = "Verified Club Ascent";
        segmentFramePrefix = "Ascent Frame";
    }
    else
    {
        var displayCategory = !string.IsNullOrWhiteSpace(rawCategory) ? rawCategory : "Expedition";
        segmentType = displayCategory;
        segmentTagline = $"{displayCategory} Log";
        segmentTaglineIcon = "fa-camera";
        segmentHighlightsTitle = $"Visual {displayCategory} Highlights";
        segmentHighlightsSubtitle = "High-resolution frames, field captures, and environmental moments documented during the journey.";
        segmentAscentBadge = $"Verified Club {displayCategory}";
        segmentFramePrefix = "Frame";
    }

    var pageTitle = !string.IsNullOrWhiteSpace(dto?.Title) 
        ? $"{dto.Title} | Climbers' Circle {segmentType} Archives" 
        : $"{segmentType} & Route Report | Climbers' Circle";
    ViewData["Title"] = pageTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var projectApiUrl = Configuration.GetSection("ServiceUrls")["ProjectAPI"] ?? "";
    if (projectApiUrl.EndsWith("/"))
    {
        projectApiUrl = projectApiUrl.TrimEnd('/');
    }
}

<link rel="stylesheet" href="~/Assets/Css/gallery-editorial.css" asp-append-version="true" />

<div class="gallery-editorial">
    <div class="gallery-editorial-container">

        <!-- Top Navigation / Breadcrumb Bar -->
        <nav class="report-nav-bar d-print-none" aria-label="Breadcrumb">
            <div class="report-breadcrumbs">
                <a href="@Url.Action("Index", "Home")"><i class="fa-solid fa-house"></i> Home</a>
                <span class="sep">/</span>
                <a href="@Url.Action("Index", "GalleryContent")"><i class="fa-solid fa-mountain-sun"></i> Archives</a>
                <span class="sep">/</span>
                <span class="current">@(dto?.Title ?? $"{segmentType} Report")</span>
            </div>
            <div class="report-nav-actions">
                <button type="button" class="btn-report-action" onclick="copyReportUrl()" title="Copy link to this climb dossier">
                    <i class="fa-solid fa-share-nodes"></i> Share
                </button>
                <button type="button" class="btn-report-action" onclick="window.print()" title="Print or save as PDF">
                    <i class="fa-solid fa-print"></i> Print Report
                </button>
                <a href="@Url.Action("Index", "GalleryContent")" class="btn-report-action">
                    <i class="fa-solid fa-arrow-left"></i> All Albums
                </a>
            </div>
        </nav>

        @if (dto == null)
        {
            <div class="expedition-empty-state">
                <i class="fa-solid fa-compass"></i>
                <h3>Expedition Record Not Found</h3>
                <p>The requested climb archive could not be located or may have been archived.</p>
                <a href="@Url.Action("Index", "GalleryContent")" class="btn-bottom-return">
                    <i class="fa-solid fa-arrow-left"></i> Return to Archives
                </a>
            </div>
        }
        else
        {
            <!-- Print-Only Official Masthead -->
            <div class="print-doc-header">
                <div class="print-doc-brand">
                    <img src="@Url.Content("~/Assets/images/CCLogo.png")" alt="Logo" class="print-doc-logo" />
                    <div>
                        <div class="print-doc-org">CLIMBERS' CIRCLE</div>
                        <div class="print-doc-tagline">Built on Rock, Proven in the Mountains — A Legacy Carved Over Fifty Years</div>
                    </div>
                </div>
                <div class="print-doc-meta">
                    <span><strong>Official Document Archive</strong></span>
                    <span>Reference #@dto.AchievementDetailsId</span>
                </div>
            </div>

            <!-- Hero Header Section -->
            <header class="gallery-hero">
                <div class="gallery-hero-badge-wrap">
                    <i class="fa-solid fa-mountain-sun"></i>
                    @(string.IsNullOrWhiteSpace(dto.SubTitle) ? "Technical Route Dossier" : dto.SubTitle)
                </div>

                <h1>@dto.Title</h1>

                @if (!string.IsNullOrWhiteSpace(dto.SubTitle))
                {
                    <div class="hero-subtitle">
                        <i class="fa-solid fa-location-crosshairs"></i> @dto.SubTitle
                    </div>
                }

                <div class="hero-meta-bar">
                    <div class="hero-meta-pill">
                        <i class="fa-solid fa-certificate"></i>
                        <span>@segmentAscentBadge</span>
                    </div>
                    <div class="hero-meta-pill">
                        <i class="fa-solid fa-book-bookmark"></i>
                        <span>Official Archive #@dto.AchievementDetailsId</span>
                    </div>
                    <div class="hero-meta-pill">
                        <i class="fa-solid fa-layer-group"></i>
                        <span>Climbers' Circle Heritage</span>
                    </div>
                </div>
            </header>

            <!-- Technical Route Report Dossier Card -->
            @if (!string.IsNullOrWhiteSpace(dto.Report))
            {
                <section class="expedition-dossier-card" id="route-dossier">
                    <div class="dossier-header-bar">
                        <div class="dossier-header-title">
                            <i class="fa-solid fa-compass-drafting"></i>
                            <span>Route Report & Field Log</span>
                        </div>
                        <span class="dossier-header-tag">
                            <i class="fa-solid fa-file-lines"></i> Technical Dossier
                        </span>
                    </div>

                    <div class="dossier-body-wrapper">
                        <article class="report-content-body">
                            @Html.Raw(dto.Report)
                        </article>
                    </div>
                </section>
            }

            <!-- Photographic Log & Key Pitches -->
            @if (dto.AchievementDetailsGalleryDetailsList != null && dto.AchievementDetailsGalleryDetailsList.Any())
            {
                <section class="expedition-gallery-section" id="photo-log">
                    <div class="section-editorial-header">
                        <div class="section-tagline">
                            <i class="fa-solid @segmentTaglineIcon"></i> @segmentTagline
                        </div>
                        <h2>@segmentHighlightsTitle</h2>
                        <p>@segmentHighlightsSubtitle</p>
                    </div>

                    <div class="gallery-items-list">
                        @{
                            var pitchIndex = 1;
                        }
                        @foreach (var item in dto.AchievementDetailsGalleryDetailsList.Where(x => x.IsActive != false))
                        {
                            var rawImg = item.ImagePath1 ?? "";
                            var imgSrc = !string.IsNullOrWhiteSpace(rawImg)
                                ? (rawImg.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? rawImg : $"{projectApiUrl}{(rawImg.StartsWith("/") ? "" : "/")}{rawImg}")
                                : "";

                            <article class="gallery-section scroll-reveal">
                                <div class="gallery-content">
                                    <div class="pitch-order-badge">
                                        <i class="fa-solid fa-flag"></i>
                                        @(item.DisplayOrder.HasValue ? $"SECTION {item.DisplayOrder.Value}" : $"FRAME #{pitchIndex}")
                                    </div>
                                    <h3>@(string.IsNullOrWhiteSpace(item.Title) ? $"{segmentFramePrefix} #{pitchIndex}" : item.Title)</h3>
                                    
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="report-content-body">
                                            @Html.Raw(item.Description)
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(imgSrc))
                                    {
                                        <button type="button" class="btn-inspect-image" onclick="openLightbox('@imgSrc', '@(item.Title?.Replace("'", "\\'"))')">
                                            <i class="fa-solid fa-magnifying-glass-plus"></i> View Full Frame
                                        </button>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(imgSrc))
                                {
                                    <div class="gallery-image-box" onclick="openLightbox('@imgSrc', '@(item.Title?.Replace("'", "\\'"))')">
                                        <img src="@imgSrc" alt="@item.Title" loading="lazy" />
                                        <div class="image-zoom-overlay">
                                            <span class="zoom-pill">
                                                <i class="fa-solid fa-expand"></i> Click to Enlarge
                                            </span>
                                        </div>
                                    </div>
                                }
                            </article>
                            pitchIndex++;
                        }
                    </div>
                </section>
            }

            <!-- Bottom Navigation Bar -->
            <footer class="report-bottom-bar d-print-none">
                <div class="bottom-bar-info">
                    <h4>Climbers' Circle Archives</h4>
                    <p>Documenting mountain expeditions, rock climbs, and wilderness exploration since 1977.</p>
                </div>
                <div class="bottom-bar-actions">
                    <button type="button" class="btn-report-action" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
                        <i class="fa-solid fa-arrow-up"></i> Back to Top
                    </button>
                    <a href="@Url.Action("Index", "GalleryContent")" class="btn-bottom-return">
                        <i class="fa-solid fa-mountain-sun"></i> Explore All Archives
                    </a>
                </div>
            </footer>
        }

    </div>
</div>

<!-- Floating Lightbox Modal -->
<div id="imageLightbox" class="lightbox-modal d-print-none" role="dialog" aria-modal="true" aria-label="Image preview">
    <div class="lightbox-dialog">
        <span class="lightbox-close" title="Close (Esc)">&times;</span>
        <img class="lightbox-content" id="img01" alt="Expedition Photo Enlarge" />
        <div class="lightbox-caption" id="lightboxCaption"></div>
    </div>
</div>

<!-- Feedback Toast -->
<div id="reportToast" class="report-toast d-print-none">
    <i class="fa-solid fa-circle-check" style="color: var(--cc-gold);"></i>
    <span id="toastMessage">Link copied to clipboard!</span>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- SCROLL REVEAL OBSERVER ---
        const sections = document.querySelectorAll('.scroll-reveal');
        if ('IntersectionObserver' in window) {
            const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, observerOptions);

            sections.forEach(section => observer.observe(section));
        } else {
            sections.forEach(s => s.classList.add('visible'));
        }

        // --- LIGHTBOX CONTROLS ---
        const modal = document.getElementById("imageLightbox");
        const closeBtn = document.querySelector(".lightbox-close");

        window.openLightbox = function(src, caption) {
            if (!modal) return;
            const modalImg = document.getElementById("img01");
            const captionElem = document.getElementById("lightboxCaption");

            modalImg.src = src;
            if (caption && caption.trim()) {
                captionElem.textContent = caption;
                captionElem.style.display = "block";
            } else {
                captionElem.style.display = "none";
            }

            modal.style.display = "flex";
            document.body.style.overflow = "hidden";
            setTimeout(() => {
                modal.classList.add("active");
            }, 10);
        };

        window.closeLightbox = function() {
            if (!modal) return;
            modal.classList.remove("active");
            setTimeout(() => {
                modal.style.display = "none";
                document.body.style.overflow = "auto";
            }, 300);
        };

        if (closeBtn) closeBtn.onclick = window.closeLightbox;
        if (modal) {
            modal.onclick = (e) => {
                if (e.target === modal || e.target.classList.contains('lightbox-dialog')) {
                    window.closeLightbox();
                }
            };
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === "Escape" && modal && modal.style.display === "flex") {
                window.closeLightbox();
            }
        });

        // --- SHARE / COPY URL ---
        window.copyReportUrl = function() {
            const url = window.location.href;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(() => {
                    showToast("Dossier URL copied to clipboard!");
                }).catch(() => {
                    fallbackCopy(url);
                });
            } else {
                fallbackCopy(url);
            }
        };

        function fallbackCopy(text) {
            const input = document.createElement("input");
            input.value = text;
            document.body.appendChild(input);
            input.select();
            document.execCommand("copy");
            document.body.removeChild(input);
            showToast("Dossier URL copied to clipboard!");
        }

        function showToast(msg) {
            const toast = document.getElementById("reportToast");
            const toastMsg = document.getElementById("toastMessage");
            if (!toast) return;
            toastMsg.textContent = msg;
            toast.classList.add("show");
            setTimeout(() => {
                toast.classList.remove("show");
            }, 3000);
        }
    });
</script>
