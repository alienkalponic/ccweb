    <!-- Small Script for Interactive Toggles on Screen -->
    <script>
        function toggleOption(el, group) {
            const siblings = el.parentElement.querySelectorAll('.toggle-box');
            siblings.forEach(s => s.classList.remove('selected'));
            el.classList.add('selected');
        }

        function toggleCheckbox(el) {
            const box = el.querySelector('.course-check-box');
            if (box) {
                box.classList.toggle('checked');
            }
        }

        function getDaySuffix(day) {
            if (day >= 11 && day <= 13) return day + "th";
            switch (day % 10) {
                case 1: return day + "st";
                case 2: return day + "nd";
                case 3: return day + "rd";
                default: return day + "th";
            }
        }

        const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

        function formatDynamicDateStr(d) {
            return getDaySuffix(d.getDate()) + " " + months[d.getMonth()] + " " + d.getFullYear();
        }

        function applyDynamicDates(sDateStr, eDateStr) {
            if (!sDateStr) return;
            const sDate = new Date(sDateStr);
            if (isNaN(sDate.getTime())) return;

            let eDate = eDateStr ? new Date(eDateStr) : new Date(sDate);
            if (isNaN(eDate.getTime())) eDate = new Date(sDate);

            // 1 day before start date for reporting
            const repDate = new Date(sDate);
            repDate.setDate(repDate.getDate() - 1);

            // 1 day after end date for return date
            const retDate = new Date(eDate);
            retDate.setDate(retDate.getDate() + 1);

            const repFormatted = formatDynamicDateStr(repDate);
            const retFormatted = formatDynamicDateStr(retDate);
            const yr = sDate.getFullYear();

            const repSpan = document.getElementById("lblReportingDate");
            if (repSpan) repSpan.textContent = repFormatted;

            const noteSpan = document.getElementById("lblNoteDate");
            if (noteSpan) noteSpan.innerHTML = "<b>" + repFormatted + " (night)</b>";

            const retSpan = document.getElementById("lblReturnDate");
            if (retSpan) retSpan.textContent = retFormatted;

            const yrSpan = document.getElementById("lblCurrentYear");
            if (yrSpan) yrSpan.textContent = yr;
        }

        document.addEventListener("DOMContentLoaded", function () {
            // 1. Check sessionStorage
            const sDateSaved = sessionStorage.getItem("cc_activity_start_date");
            const eDateSaved = sessionStorage.getItem("cc_activity_end_date");
            if (sDateSaved) {
                applyDynamicDates(sDateSaved, eDateSaved);
            }

            // 2. Check URL query parameters
            const params = new URLSearchParams(window.location.search);
            const pStartDate = params.get("startDate");
            const pEndDate = params.get("endDate");
            const actId = params.get("id") || params.get("activityId");

            if (pStartDate) {
                applyDynamicDates(pStartDate, pEndDate);
            } else if (actId && !sDateSaved) {
                fetch('/api/content/Get-activity-details-by-activitie-id/' + actId)
                    .then(res => res.json())
                    .then(data => {
                        const item = Array.isArray(data.response) ? data.response[0] : (Array.isArray(data) ? data[0] : null);
                        if (item && item.startDate) {
                            applyDynamicDates(item.startDate, item.endDate);
                        }
                    })
                    .catch(function () {});
            }
        });
    </script>

