@{
    Layout =null;
    
}
<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width" />
    <title>AdminLogin</title>
    <link rel="shortcut icon" href="@Url.Content("~/images/favicon.png")">

    <!-- Core CSS -->
    <link href="@Url.Content("~/Assets/Css/bootstrap.min.css")" rel="stylesheet" asp-append-version="true">
    <link href="@Url.Content("~/Assets/Admin/Css/admin-variables.css")" rel="stylesheet" asp-append-version="true">
    <link href="@Url.Content("~/Assets/Css/font-awesome.css")" rel="stylesheet" asp-append-version="true">
    <link href="@Url.Content("~/Assets/Admin/Css/admin-login.css")" rel="stylesheet" asp-append-version="true">

    @*Style for validate border By Imad*@
    <style>
        .validateInputborder {
            border: 1px solid var(--admin-primary) !important;
            box-shadow: 0 0 0 4px var(--admin-primary-light) !important;
        }
    </style>
</head>
<body class="admin-login-body">
    <!-------Loader div start---->
    <div class="ui-loader ui-loader-default hide">
        <div class="ui-icon ui-icon-loading"></div>
    </div>
    <!-- loader div end-->

    <div class="login-card">
        <div class="login-header">
            <h2>Climbers' Circle</h2>
            <p>Admin Control Panel</p>
        </div>

        <form class="login_form" id="AdminLoginForm">
            <div class="form-group">
                <label class="form-label" for="user_name">Email / Username</label>
                <input type="text" id="user_name" placeholder="Username or Email" class="form-control-modern" required>
            </div>

            <div class="form-group">
                <label class="form-label" for="password">Password</label>
                <input type="password" id="password" placeholder="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" class="form-control-modern" required>
            </div>

            <div class="form-group">
                <label class="remember-me-container" for="chkRemember">
                    <input type="checkbox" id="chkRemember">
                    <span>Keep me signed in</span>
                </label>
            </div>

            <div class="form-group">
                <button class="btn-login-modern" type="button" id="BtnSignIn">
                    <span class="btn-text">Sign In to Dashboard</span>
                    <div class="btn-loading-spinner"></div>
                </button>
            </div>

            <div class="alert hide mt-3" id="LogInAlert" style="font-size: 13px; border-radius: var(--admin-radius-sm);"></div>
        </form>

        <div class="login-footer">
            &copy; @DateTime.Now.Year Climbers Circle. All rights reserved.
        </div>
    </div>

    <!-- Placed js at the end of the document so the pages load faster -->
    <!--Core js-->
</body>
<script src="@Url.Content("~/Assets/Js/jquery-2.2.4.min.js")" asp-append-version="true"></script>
<script src="@Url.Content("~/Assets/Js/Common.min.js")" asp-append-version="true"></script>
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="@Url.Content("~/Assets/Script/Authentication.js")" asp-append-version="true"></script>

