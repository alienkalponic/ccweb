<body class="login-body">
    <!-------Loader div start---->
    <div class="ui-loader ui-loader-default hide">
        <div class="ui-icon ui-icon-loading"></div>
    </div>
    <!-- loader div end-->
    <div class="container">
        <div class="form-signin">
            <h2 class="form-signin-heading">Climbers' Circle</h2>
            <div class="login-wrap">
                <form class="login_form">
                    <div class="user-login-info">
                        <input type="email" id="user_name" placeholder="Enter User Name" class="form-control en">
                        <input type="password" id="password" placeholder="Enter Password" class="form-control en">
                        @* @Html.EditorFor(model => Model.UserName, new { htmlAttributes = new { @id = "user_name", @placeholder = "Enter User Name", @class = "form-control en", title = "User Name" } }) *@
                        @*<input type="password" class="form-control en" placeholder="Password" id="txtPassword" value="">*@
                        @* @Html.EditorFor(model => Model.Password, new { htmlAttributes = new { @id = "password", @placeholder = "Enter Password ", @class = "form-control en", title = "Password", autocomplete = "off" } }) *@
                    </div>
                    <label class="checkbox form-control" style="font-size: 13px;">

                        <input type="checkbox" value="remember-me" id="chkRemember" checked>



                        Remember me

                    </label>
                    <button class="btn btn-lg btn-login btn-block" type="button" id="BtnSignIn">Sign in</button>


                    <div class="alert hide" id="LogInAlert"></div>
                </form>
                    
                
            </div>
        </div>
    </div>

    <!-- Placed js at the end of the document so the pages load faster -->
    <!--Core js-->
</body>
<script src="@Url.Content("~/Assets/Js/jquery-2.2.4.min.js")" asp-append-version="true"></script>
<script src="@Url.Content("~/Assets/Js/Common.min.js")" asp-append-version="true"></script>
