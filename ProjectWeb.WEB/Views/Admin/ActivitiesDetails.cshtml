@{
    ViewData["Title"] = "ActivitiesDetails";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}
@using System.Security.Claims
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    var ROLE_NAME = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
    var projectApiUrl = Configuration.GetSection("ServiceUrls")["ProjectAPI"];
}

<script>
    var _ProjectAPI = '@projectApiUrl';
</script>

@if (ROLE_NAME == "Developer" || ROLE_NAME == "Administrator" || ROLE_NAME == "2")
{
    <!--main content start-->
    <section id="main-content">
        <section class="wrapper">
            <section class="panel mb-4 animate-fade-in">
                <header class="panel-heading border-none bg-transparent" style="display: flex; justify-content: space-between; align-items: center; padding: 0;">
                    <h2 class="mb-0">Activities Details Management</h2>
                    <button type="button" class="btn btn-primary" id="btnAddNew">
                        <i class="fa fa-plus"></i> Add New Activitie
                    </button>
                </header>
            </section>

            <div id="activitietableimg" class="table-responsive animate-fade-in">

                <table id="tab_banner_img" class="table" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <th>SL.No</th>
                            <th>Preview</th>
                            <th>Caption</th>
                            <th>Priority</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

            </div>

            <div class="pagination_oputer" style="text-align: right!important;">
                <ul class="pagination"></ul>
            </div>
            <div id="prtProfile">
            </div>
        </section>
    </section>
    <!--main content end-->
    <!---------Popup modal-------->
    <button class="link_add hide" style="display:none;" data-toggle="modal" data-target="#addactivitieModal" role="button" id="hdnOpenModel">Open Model</button>



    <div class="modal fade" id="addactivitieModal" tabindex="-1" role="dialog" aria-labelledby="addActivityModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: var(--admin-radius-lg);">
                <div class="modal-header border-bottom-0 pb-0" style="padding: 1.5rem 1.5rem 0.5rem 1.5rem;">
                    <div class="d-flex align-items-center w-100">
                        <div class="modal-title-container d-flex align-items-center">
                            <div class="icon-box bg-primary-soft text-primary mr-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background: rgba(160, 28, 43, 0.1);">
                                <i class="fa fa-tasks fs-4" style="color: var(--admin-primary);"></i>
                            </div>
                            <h4 class="modal-title fw-bold m-0" id="addActivityModalTitle" style="font-family: var(--admin-font-heading); color: var(--admin-text-main);">Add Club Activity</h4>
                        </div>
                        <button type="button" class="btn-close ms-auto border-0 bg-transparent text-muted btnCancelActivity" aria-label="Close" style="font-size: 1.5rem; line-height: 1;">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>

                <div class="modal-body p-4">
                    <form id="activityForm" novalidate onsubmit="return false;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="hdn_ActivityId" name="UpdateClubActivityDto.ActivityId" value="0" />

                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold mb-2">Title <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtActivityTitle" name="CreateClubActivityDto.Title" placeholder="Enter title..." required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold mb-2">SubTitle</label>
                                <input type="text" class="form-control" id="txtActivitySubTitle" name="CreateClubActivityDto.SubTitle" placeholder="Enter subtitle...">
                            </div>

                            <!-- Description -->
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-semibold mb-2">Description</label>
                                <div id="quillEditorContainer" style="height: 200px; border-radius: 0 0 var(--admin-radius-sm) var(--admin-radius-sm);"></div>
                                <input type="hidden" id="hdnDescription" name="CreateClubDescriptionDto.Description">
                            </div>

                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-semibold mb-2">Redirect URL</label>
                                <input type="text" class="form-control" id="txtRedirectUrl" name="CreateClubActivityDto.RedirectUrl" placeholder="https://...">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold mb-2">Display Order</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa fa-sort"></i></span>
                                    <input type="number" class="form-control" id="numActivityDisplayOrder" value="0" min="0" name="CreateClubActivityDto.DisplayOrder">
                                </div>
                            </div>

                            <div class="col-md-6 mb-3 d-flex align-items-end" id="divActivityStatus">
                                <div class="form-check form-switch p-0 ml-4 mb-2">
                                    <label class="form-check-label fw-semibold mr-3" for="chkActivityIsActive">Is Active</label>
                                    <div class="custom-control custom-switch pt-1 d-inline-block">
                                        <input type="checkbox" class="custom-control-input" id="chkActivityIsActive" name="CreateClubActivityDto.IsActive" checked>
                                        <label class="custom-control-label" for="chkActivityIsActive"></label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-semibold d-block mb-2">Upload Images <span class="text-danger">*</span></label>
                                <div class="upload-zone p-4 text-center border-dashed rounded-3 bg-light" id="dropZone" style="border: 2px dashed #e2e8f0; cursor: pointer; transition: all 0.3s ease; border-radius: var(--admin-radius-md);">
                                    <input type="file" id="fileInput" multiple accept="image/*" class="d-none" name="CreateClubDescriptionDto.Files">
                                    <div class="upload-content py-2" id="btnBrowse">
                                        <i class="fa fa-cloud-upload text-muted mb-2" style="font-size: 2.5rem;"></i>
                                        <p class="mb-1 text-dark fw-bold">Click to upload or drag and drop</p>
                                        <p class="text-muted small">Only images (JPG, PNG, WEBP) are allowed</p>
                                    </div>
                                </div>
                                <div id="imagePreviewContainer" class="row g-2 mt-3">
                                    <!-- Dynamic previews go here -->
                                </div>
                                <div id="imageError" class="text-danger small mt-1 d-none">Please select at least one image.</div>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="modal-footer border-top-0 p-4 pt-0 justify-content-end">
                    <button type="button" class="btn btn-light px-4 mr-2 btnCancelActivity" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary px-4 d-flex align-items-center" id="btnSaveActivity">
                        <span class="spinner-border spinner-border-sm me-2 d-none btnSpin" role="status" aria-hidden="true"></span>
                        <span class="btnText"><i class="fa fa-save mr-2"></i> Save Changes</span>
                    </button>
                    <button type="button" class="btn btn-primary px-4 d-flex align-items-center d-none" id="btnUpdateActivity">
                        <span class="spinner-border spinner-border-sm me-2 d-none btnSpin" role="status" aria-hidden="true"></span>
                        <span class="btnText"><i class="fa fa-refresh mr-2"></i> Update</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}