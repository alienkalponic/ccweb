@model ProjectWeb.Domain.Model.MultipleModel
@inject IConfiguration Configuration
@{
    var parentGallery = Model?.AchievementDetailsGalleryDtos;
    var galleryId = ViewBag.GalleryId != null ? (int)ViewBag.GalleryId : 0;
    var galleryItemId = ViewBag.GalleryItemsId != null ? (int)ViewBag.GalleryItemsId : (galleryId == 32 ? 32 : 0);
    if (galleryItemId <= 0 && parentGallery?.GalleryItemsId.HasValue == true && parentGallery.GalleryItemsId.Value > 0)
    {
        galleryItemId = (int)parentGallery.GalleryItemsId.Value;
    }

    var albumTitle = ViewBag.AlbumTitle as string;
    if (string.IsNullOrWhiteSpace(albumTitle) && !string.IsNullOrWhiteSpace(parentGallery?.Title))
    {
        albumTitle = parentGallery.Title;
    }

    var categoryName = ViewBag.CategoryName as string;
    if (string.IsNullOrWhiteSpace(categoryName) && !string.IsNullOrWhiteSpace(parentGallery?.SubTitle))
    {
        categoryName = parentGallery.SubTitle;
    }

    if (string.IsNullOrWhiteSpace(albumTitle) && (galleryId == 32 || galleryId == 8 || galleryItemId == 32))
    {
        albumTitle = "GAJABURU SOUTH FACE";
        categoryName = "LEAD CLIMB";
        galleryItemId = 32;
    }
    
    ViewData["Title"] = !string.IsNullOrWhiteSpace(albumTitle) 
        ? $"{albumTitle} - Album Details | Climbers' Circle" 
        : "Album Details - Climbers' Circle";
        
    Layout = "~/Views/Shared/_Layout.cshtml";
    string imagePath = Url.Content("~/");
    var projectApiUrl = Configuration.GetSection("ServiceUrls")["ProjectAPI"] ?? "";
    if (projectApiUrl.EndsWith("/"))
    {
        projectApiUrl = projectApiUrl.TrimEnd('/');
    }

    var reportUrl = galleryItemId > 0 
        ? Url.Action("Gallery", "Home", new { id = galleryItemId }) 
        : "#";
}

<link rel="stylesheet" href="~/Assets/Css/gallery.css" asp-append-version="true" />

<!-- Dynamic Album Details Header -->
<div class="gallery-details-header">
    <input type="hidden" id="apiurl" value="@projectApiUrl" />
    <input type="hidden" id="albumId" value="@(ViewBag.GalleryId ?? 0)" />
    <input type="hidden" id="galleryItemsId" value="@galleryItemId" />
    <input type="hidden" id="serverAlbumTitle" value="@(albumTitle ?? "")" />
    <input type="hidden" id="serverCategory" value="@(categoryName ?? "")" />
    <input type="hidden" id="serverYear" value="@(ViewBag.ExpeditionYear ?? 0)" />

    <div class="container">
        <div class="gallery-details-topbar">
            <a href="@Url.Action("Index", "GalleryContent")" class="back-btn">
                <i class="fa-solid fa-arrow-left"></i> Back to Albums
            </a>
            <span class="gallery-badge" id="dynamicAlbumCategory">
                <i class="fa-solid fa-mountain-sun"></i> @(string.IsNullOrWhiteSpace(categoryName) ? "ALBUM ARCHIVE" : categoryName.ToUpper())
            </span>
        </div>

        <h1 class="gallery-details-title" id="dynamicAlbumTitle">
            @(string.IsNullOrWhiteSpace(albumTitle) ? "Adventure Gallery" : albumTitle)
        </h1>
        <p class="gallery-details-subtitle" id="dynamicAlbumSubtitle">
            @(string.IsNullOrWhiteSpace(categoryName) 
                ? "Captured moments and expedition memories" 
                : $"Official {categoryName} photographic documentation & expedition field captures")
        </p>
    </div>
</div>

<!-- Gallery Details Grid Container -->
<div class="container gallery-details-container">
    
    <!-- Photo Cards Grid (Rendered Server-Side for zero delay) -->
    <div class="gallery-details-grid" id="detailsimageBind">
        @if (parentGallery?.AchievementDetailsGalleryDetailsList != null && parentGallery.AchievementDetailsGalleryDetailsList.Any())
        {
            var activePhotos = parentGallery.AchievementDetailsGalleryDetailsList.Where(x => x.IsActive != false).ToList();
            for (int i = 0; i < activePhotos.Count; i++)
            {
                var val = activePhotos[i];
                var photoNumber = i + 1;
                var rawImg = val.ImagePath1 ?? "";
                var src = !string.IsNullOrWhiteSpace(rawImg)
                    ? (rawImg.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? rawImg : $"{projectApiUrl}{(rawImg.StartsWith("/") ? "" : "/")}{rawImg}")
                    : "";
                var pTitle = !string.IsNullOrWhiteSpace(val.Title) ? val.Title : $"{albumTitle} #{photoNumber}";

                <div class="gallery-item" data-index="@i" role="button" tabindex="0">
                    <img src="@src" alt="@pTitle" class="gallery-item-img" loading="lazy">
                    <div class="gallery-item-overlay">
                        <div class="gallery-zoom-icon">
                            <i class="fa-solid fa-expand"></i>
                        </div>
                        <span class="gallery-item-caption">@pTitle</span>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Bottom Navigation Bar -->
    <div class="gallery-bottom-back">
        @if (parentGallery?.AchievementDetailsGalleryDetailsList != null && parentGallery.AchievementDetailsGalleryDetailsList.Any())
        {
            <span class="text-muted font-size-sm" id="dynamicPhotoCountText">
                <i class="fa-regular fa-images"></i> Showing @parentGallery.AchievementDetailsGalleryDetailsList.Count(x => x.IsActive != false) High-Res Photos
            </span>
        }
        else
        {
            <span class="text-muted font-size-sm" id="dynamicPhotoCountText">
                <i class="fa-regular fa-compass"></i> Climbers' Circle Official Expedition Gallery
            </span>
        }
        <div class="gallery-bottom-actions">
            <!-- REPORT BUTTON (Opens /Home/Gallery/{id}) -->
            <a href="@reportUrl" 
               class="report-btn" 
               id="btnAlbumReport" 
               style="@(galleryItemId <= 0 ? "display:none;" : "")" 
               title="View official expedition & climb report">
                <i class="fa-solid fa-file-lines"></i> Report
            </a>

            <a href="@Url.Action("Index", "GalleryContent")" class="back-btn bottom-back-btn">
                <i class="fa-solid fa-grid-2"></i> View All Albums
            </a>
        </div>
    </div>
</div>

<!-- Modern Glass Lightbox Modal -->
<div id="lightbox" class="lightbox">
    <div class="lightbox-header">
        <div class="lightbox-counter" id="lightbox-counter">1 / 8</div>
        <div class="lightbox-close" title="Close (Esc)">
            <i class="fa-solid fa-xmark"></i>
        </div>
    </div>

    <div class="lightbox-content">
        <div class="lightbox-prev" title="Previous Image (Left Arrow)">
            <i class="fa-solid fa-chevron-left"></i>
        </div>
        
        <img class="lightbox-image" id="lightbox-img" src="" alt="Gallery Photo">
        
        <div class="lightbox-next" title="Next Image (Right Arrow)">
            <i class="fa-solid fa-chevron-right"></i>
        </div>
    </div>

    <div class="lightbox-caption" id="lightbox-caption"></div>
    
    <!-- Dynamic Thumbnail Carousel Bar -->
    <div class="lightbox-thumbnails" id="lightbox-thumbnails"></div>
</div>
