@model ProjectWeb.Domain.Model.MultipleModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Expedition Albums & Social Feeds";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string imagePath = Url.Content("~/");
    var projectApiUrl = Configuration.GetSection("ServiceUrls")["ProjectAPI"];
    var instaToken = ViewBag.InstagramAccessToken as string ?? "";
}

<link rel="stylesheet" href="~/Assets/Css/gallery.css" />

<!-- Hero Header Section -->
<section class="gallery-hero-section">
    <div class="gallery-hero-bg-glow"></div>
    <div class="container">
        <div class="gallery-badge">
            <i class="fa-solid fa-mountain-sun"></i> CLIMBERS' CIRCLE ARCHIVES
        </div>
        <h1 class="gallery-title">
            Expedition & Training <span>Albums</span>
        </h1>
        <p class="gallery-subtitle">
            Explore visual memories, high-altitude expeditions, rock climbing courses, and live social media feeds from our team.
        </p>

        <!-- Search & Filter Bar -->
        <div class="gallery-controls-bar">
            <div class="gallery-filter-tabs">
                <button class="gallery-filter-btn active" data-filter="all">All Albums</button>
                @if(Model.CategoryDtos!=null)
                {
                    foreach (var item in Model.CategoryDtos!)
                    {
                        <button class="gallery-filter-btn" data-filter="@item.CategoryName">@item.CategoryName</button>
                    }
                }
                @*<button class="gallery-filter-btn" data-filter="training">Training</button>
                <button class="gallery-filter-btn" data-filter="climbing">Rock Climbing</button>
                <button class="gallery-filter-btn" data-filter="camp">Summer Camp</button>
                <button class="gallery-filter-btn" data-filter="Expedition">Expeditions</button>
                <button class="gallery-filter-btn" data-filter="treks">Treks</button>*@
            </div>
            <div class="gallery-search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="albumSearchInput" placeholder="Search albums..." />
            </div>
        </div>
    </div>
</section>

<!-- Animated Stats Section -->
<div class="gallery-stats-grid">
    <div class="stat-card">
        <div class="stat-icon">
            <i class="fa-solid fa-folder-closed"></i>
        </div>
        <div class="stat-info">
            @if (Model.GalleryListDtos!.Count>5)
            {
                <h4>5+</h4>
            }
            else
            {
                <h4>@Model.GalleryListDtos!.Count()</h4>
            }
            
            <p>Active Albums</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">
            <i class="fa-brands fa-instagram"></i>
        </div>
        <div class="stat-info">
            <h4>12.5k</h4>
            <p>Instagram Followers</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">
            <i class="fa-brands fa-facebook"></i>
        </div>
        <div class="stat-info">
            <h4>18k+</h4>
            <p>Facebook Members</p>
        </div>
    </div>
</div>

<!-- Main Albums Grid Section -->
<div class="container gallery-container">
    <div class="gallery-grid" id="albumGrid">
