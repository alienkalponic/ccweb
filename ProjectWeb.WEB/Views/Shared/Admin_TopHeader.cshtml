@using System.Security.Claims
<!--header start-->
<header class="header fixed-top clearfix">

    <!--logo start-->
    <div class="brand">
        <a href="@Url.Content("~/Admin/Dashboard")" class="logo">
            <span class="logo-text">Climbers'<span>Circle</span></span>
        </a>
        <div class="sidebar-toggle-box">
            <i class="fa fa-bars"></i>
        </div>
    </div>
    <!--logo end-->
    <div class="nav notify-row" id="top_menu">
        <!--  notification start -->
        <!--  notification end -->
    </div>
    <div class="top-nav clearfix">
        <!--search & user info start-->
        <ul class="nav pull-right top-menu">

            <li class="dropdown">
                <a data-toggle="dropdown" class="dropdown-toggle user-trigger" href="javascript:void(0);">
                    <div class="user-avatar">
                        <img alt="User Avatar" src="@Url.Content("~/Assets/WithLogin/images/dashboard_logo.png")">
                    </div>
                    <span class="username">
                        @User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value
                    </span>
                    <i class="fa fa-angle-down"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-right header-dropdown">
                    <li class="dropdown-header">Account Settings</li>
                    <li>
                        <a href="@Url.Content("~/Admin/AdminProfile")">
                            <i class="fa fa-user"></i> <span>Profile</span>
                        </a>
                    </li>
                    <li class="divider"></li>
                    <li>
                        <a href="@Url.Content("~/Admin/Logout")" class="text-danger">
                            <i class="fa fa-sign-out"></i> <span>Log Out</span>
                        </a>
                    </li>
                </ul>
            </li>
            <!-- user login dropdown end -->
            @*<li>
                <div class="toggle-right-box">
                    <div class="fa fa-bars"></div>
                </div>
            </li>*@
        </ul>
        <!--search & user info end-->
    </div>
</header>
