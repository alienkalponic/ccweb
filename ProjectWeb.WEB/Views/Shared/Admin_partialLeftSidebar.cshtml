<script>
    document.addEventListener("DOMContentLoaded", () => {
        const subMenus = document.querySelectorAll(".sub-menu > a.pos");
        subMenus.forEach(menu => {
            menu.addEventListener("click", () => {
                const subMenuList = menu.nextElementSibling;
                if (subMenuList) {
                    subMenuList.classList.toggle("open"); // Add or remove the 'open' class
                }
            });
        });
    });

</script>
