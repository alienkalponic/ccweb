<!--Leftsidebar end-->

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".sub-menu > a").forEach(function (menu) {
            menu.addEventListener("click", function (e) {
                e.preventDefault();
                
                const parentLi = this.parentElement;
                const submenu = this.nextElementSibling;
                
                if (submenu && submenu.classList.contains("sub")) {
                    // Close other open submenus at the same level if desired (accordion style)
                    // parentLi.parentElement.querySelectorAll(':scope > li > .sub.open').forEach(openSub => {
                    //     if (openSub !== submenu) openSub.classList.remove('open');
                    // });

                    submenu.classList.toggle("open");
                    this.classList.toggle("active");
                }
            });
        });

        // Auto-expand current active menu based on URL
        const currentPath = window.location.pathname;
        document.querySelectorAll(".sidebar-menu a").forEach(function(link) {
            if (link.getAttribute("href") && currentPath.includes(link.getAttribute("href"))) {
                link.classList.add("active");
                // Expand parent sub-menus
                let parent = link.closest(".sub");
                while (parent) {
                    parent.classList.add("open");
                    let toggle = parent.previousElementSibling;
                    if (toggle) toggle.classList.add("active");
                    parent = parent.parentElement.closest(".sub");
                }
            }
        });
    });
</script>
