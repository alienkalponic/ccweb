<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- IIS request size limit. Default is ~28.6 MB (30000000 bytes).
         Without this setting, IIS rejects large uploads BEFORE ASP.NET Core is invoked
         (the MVC action is never hit). Set to 500 MB here to match Kestrel limit. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>

    <!-- Anti-WebDAV fix: Remove WebDAV to allow DELETE/PUT methods -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet"
                arguments=".\ProjectWeb.WEB.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>

  </system.webServer>
</configuration>
